{
    "manifest_version": 3,
    "name": "EasyMaps",
    "description": "An easier and instant way of playing Minecraft maps!",
    "version": "1.0.0",
    "browser_specific_settings": {
        "gecko": {
            "id": "extension@easymaps.com"
        }
    },
    "permissions": ["nativeMessaging", "downloads"],
    "content_scripts": [
        {
            "matches": ["https://www.minecraftmaps.com/*"],
            "js": ["./dist/adapters/minecraft-maps.adapter.js"]
        }
    ],
    "background": {
        "scripts": ["dist/background.js"],
        "type": "module"
    }
}
